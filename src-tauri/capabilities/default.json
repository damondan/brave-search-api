{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-save",

    "fs:allow-mkdir",
    "fs:allow-write-text-file",

    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/Media/braveSearchApi/**/*"
      ]
    }
  ]
}